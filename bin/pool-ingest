#!/bin/bash
# Usage: bin/pool-ingest PKG...
# Adds built packages to the immutable pool and signs them.
set -euo pipefail
here=$(cd "$(dirname "$0")/.." && pwd)
pool=/tmp/opr-poc1/repo/x86_64
export GNUPGHOME=/tmp/opr-poc1/gnupg
mkdir -p "$pool"
for p in "$@"; do
  f=$pool/$(basename "$p")
  cp "$p" "$f"
  gpg --batch --quiet --detach-sign --no-armor -u poc@omarchy.org -o "$f.sig" "$f"
  echo "ingested $(basename "$p")"
done
